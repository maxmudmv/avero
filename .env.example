# ==============================================================================
# AVERO — Environment Variables Template
# Copy this file to .env and fill in real values locally.
# NEVER commit .env or any real secrets to Git.
# ==============================================================================

# --- Runtime ---
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PostgreSQL (Neon Free Tier or Local PostgreSQL 16+) ---
# Runtime connection MUST use the non-superuser `avero_app` role (NOBYPASSRLS)
DATABASE_URL=postgresql://avero_app:CHANGE_ME@localhost:5432/avero_dev?sslmode=disable
# Direct/owner connection used ONLY for running schema migrations
DATABASE_MIGRATION_URL=postgresql://avero_migrator:CHANGE_ME@localhost:5432/avero_dev?sslmode=disable
# Optional: disable TLS rejection only if needed for custom certs; standard Neon uses SSL
DATABASE_SSL=false

# --- Security & Cryptography ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=replace_with_at_least_64_hex_characters_secret_key_for_oauth_state
AUDIT_IP_SALT=replace_with_at_least_32_hex_characters_salt_for_ip_hashing
SESSION_TTL_DAYS=30

# --- Google OAuth 2.0 (Web Authentication) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# --- Telegram Mini App (Server-side initData HMAC verification) ---
# Bot token is strictly server-only; never expose in NEXT_PUBLIC_* variables
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_APP_SHORT_NAME=

# --- Super Admin Governance (Optional comma-separated verified Google emails) ---
SUPER_ADMIN_EMAILS=

# --- Rate Limiting (Upstash Redis Free Tier — optional in local dev) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
